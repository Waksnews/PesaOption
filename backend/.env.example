PORT=3000
NODE_ENV=development

# PostgreSQL Database URL for Prisma (Neon / Cloud SQL)
DATABASE_URL=

# Africa's Talking SMS Gateway configuration
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AT_USERNAME=sandbox
